{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake --preset Debug && cmake --build --preset Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash (OpenOCD)",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -f target/stm32f1x.cfg -c \"program build/Debug/range-test-rx.elf verify reset exit\"",
            "dependsOn": ["Build (Debug)"],
            "problemMatcher": []
        }
    ]
}
